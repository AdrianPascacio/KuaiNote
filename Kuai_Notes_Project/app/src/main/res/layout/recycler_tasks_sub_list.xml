<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/Layout_Item"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:outlineSpotShadowColor="@color/Light_medium_brown"
    android:outlineAmbientShadowColor="@color/transparent"
    android:layout_marginTop="0dp"
    android:layout_marginHorizontal="15dp"

    >
    <LinearLayout
        xmlns:app="http://schemas.android.com/apk/res-auto"
        app:cardCornerRadius="25dp"
        android:id="@+id/Layout_Global_Item"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingVertical="10dp"
        android:paddingHorizontal="15dp"
        android:requiresFadingEdge="horizontal"
        android:fadingEdge="horizontal"
        android:background="@drawable/rounded_layout_7dp"
        android:outlineSpotShadowColor="@color/light_brown_natural"
        android:outlineAmbientShadowColor="@color/transparent"
        android:fadingEdgeLength="20dp"
        android:orientation="vertical"
        >

        <!--
        si le falta titulo 20 arriba y 10 abajo
        android:layout_marginVertical="10dp"
        -->

        <TextView
            android:id="@+id/Text_Task_Sub_Title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="60dp"
            android:text=""
            android:hint="Sub Note Example"
            android:textSize="20sp"
            android:textColor="@color/item_visualizer_title_text_color"
            android:textStyle="normal" />

    </LinearLayout>


    <LinearLayout
        android:id="@+id/Layout_Completed_Mark_Ghost"
        android:layout_width="60dp"
        android:layout_height="match_parent"
        android:layout_gravity="start|center_vertical"
        android:layout_marginTop="0dp"
        android:layout_marginRight="38dp"
        android:layout_marginBottom="0dp"
        android:gravity="center_vertical"
        android:orientation="vertical">


        <FrameLayout
            android:id="@+id/Fl_Completed_Mark_Ghost"
            android:layout_width="match_parent"
            android:layout_height="32dp"
            android:layout_gravity="center_vertical"
            android:layout_marginBottom="0dp"
            android:clickable="false"
            android:focusable="false"
            android:longClickable="false" />
    </LinearLayout>
    <LinearLayout
        android:id="@+id/Layout_Completed_Mark"
        android:layout_width="60dp"
        android:layout_height="match_parent"
        android:layout_gravity="start|center_vertical"
        android:layout_marginTop="0dp"
        android:layout_marginRight="38dp"
        android:layout_marginBottom="0dp"
        android:gravity="center_vertical"
        android:orientation="vertical">


        <FrameLayout
            android:id="@+id/Fl_Completed_Mark"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_gravity="center"
            android:layout_marginLeft="18dp"
            android:background="@drawable/icon_complete_task_test_4"
            android:backgroundTint="@color/item_visualizer_icon_neutral_tint"
            android:clickable="false"
            android:focusable="false"
            android:longClickable="false" />
    </LinearLayout>
    <LinearLayout
        android:id="@+id/Layout_Upper_Line"
        android:layout_width="26dp"
        android:layout_height="match_parent"
        android:layout_gravity="left"
        android:layout_marginTop="0dp"
        android:gravity="center_vertical"
        android:background="@color/white_bamboo"
        android:visibility="gone"
        android:orientation="vertical">

    </LinearLayout>


</androidx.cardview.widget.CardView>
