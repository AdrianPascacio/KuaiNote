<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:id="@+id/Selection_Menu_TrashCan_relative_item_view"
    android:background="@drawable/selection_menu_trashcan_popup_layout"
    >



    <LinearLayout
        android:id="@+id/Layout_Selection_Menu_Trashcan"
        android:layout_width="100dp"
        android:layout_height="200dp"
        android:layout_marginLeft="6dp"
        android:layout_marginVertical="6dp"
        android:background="@drawable/selection_menu_trashcan_popup_layout"
        android:gravity="center"
        android:orientation="vertical">


        <FrameLayout
            android:id="@+id/FL_SM_T_Recycle"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:gravity="center|bottom"
            android:layout_alignParentStart="true"
            android:layout_alignParentEnd="true"
            android:background="@drawable/recycler_logo_icon_4"
            android:backgroundTint="@color/item_visualizer_icon_recycler_tint"
            />
        <Space
            android:layout_width="match_parent"
            android:layout_height="20dp"
            >
        </Space>
        <FrameLayout
            android:id="@+id/FL_SM_T_Delete"
            android:layout_width="27dp"
            android:layout_height="32dp"
            android:gravity="center|bottom"
            android:layout_below="@+id/FL_SM_T_Recycle"
            android:layout_alignParentStart="true"
            android:layout_alignParentEnd="true"
            android:background="@drawable/fire_icon_5"
            android:backgroundTint="@color/fire_icon"
            />

    </LinearLayout>


</RelativeLayout>