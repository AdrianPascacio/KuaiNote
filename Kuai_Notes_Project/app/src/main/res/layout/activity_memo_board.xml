<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/note_visualizer_main_background"
    tools:context=".Memo_Board">

    <LinearLayout
        android:id="@+id/linearLayout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="29dp"
        android:orientation="vertical">
        <EditText
            android:id="@+id/Searched_Text"
            android:layout_width="383dp"
            android:layout_height="62dp"
            android:ems="10"
            android:inputType="text"
            android:text=""
            android:hint="Search:"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/Recycler_MemoBoard"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:paddingBottom="155dp"
                android:clipToPadding="false"
                />




    </LinearLayout>

    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/floatingActionButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:clickable="true"
        android:focusable="true"
        app:backgroundTint="@color/memoboard_add_button_background"
        app:fabCustomSize="100dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.92"
        app:layout_constraintHorizontal_bias="0.84"
        app:maxImageSize="85dp"
        app:shapeAppearanceOverlay="@style/CircularShapeStyle"
        app:srcCompat="@drawable/cruz_add_note"
        app:tint="@color/white"
        android:outlineAmbientShadowColor="@color/transparent"
        android:outlineSpotShadowColor="@color/transparent"

        />
    <Button
        android:id="@+id/button_Config"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:layout_marginRight="120dp"
        android:layout_marginTop="14dp"
        android:background="@drawable/recycler_logo_icon_4"
        android:backgroundTintMode="multiply"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <Button
        android:id="@+id/button_Check_Lists"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:layout_marginRight="70dp"
        android:layout_marginTop="14dp"
        android:background="@drawable/outline_fact_check_24"
        android:backgroundTintMode="multiply"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <Button
        android:id="@+id/button_Search"
        android:layout_width="24dp"
        android:layout_height="30dp"
        android:layout_marginRight="23dp"
        android:layout_marginTop="14dp"
        android:background="@drawable/search_icon_4"
        android:backgroundTintMode="multiply"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <Button
        android:id="@+id/button_Generate_Random_Content"
        android:layout_width="36dp"
        android:layout_height="30dp"
        android:layout_marginRight="170dp"
        android:layout_marginTop="14dp"
        android:background="@drawable/aux_randome_test_generator"
        android:backgroundTintMode="multiply"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <Button
        android:id="@+id/button_Generate_Stable_Content"
        android:layout_width="36dp"
        android:layout_height="30dp"
        android:layout_marginRight="220dp"
        android:layout_marginTop="14dp"
        android:background="@drawable/aux_randome_test_generator"
        android:backgroundTintMode="multiply"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />
    <Button
        android:id="@+id/button_Delete_All_Notes_DataBase"
        android:layout_width="36dp"
        android:layout_height="30dp"
        android:layout_marginRight="270dp"
        android:layout_marginTop="14dp"
        android:background="@drawable/aux_delete_all_database"
        android:backgroundTintMode="multiply"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />


    <LinearLayout
        android:id="@+id/layout_dim_itemVisualizer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/white_sand_light_trans"
        android:orientation="vertical"
        android:visibility="gone"

        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        >

    </LinearLayout>
    <LinearLayout
        android:id="@+id/floatingMenu"
        android:layout_width="wrap_content"
        android:layout_height="60dp"
        android:orientation="horizontal"
        android:background="@color/transparent"
        android:translationX="55dp"
        app:layout_constraintVertical_bias="0.96"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:id="@+id/menuTab"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"

            >

            <Space
                android:layout_width="20dp"
                android:layout_height="match_parent"
                >

            </Space>
            <FrameLayout
                android:layout_width="35dp"
                android:layout_height="match_parent"
                android:background="@drawable/bg_floating_recycler_view">

                <TextView
                    android:id="@+id/tabArrow"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="&lt;"
                    android:textColor="@color/Trashcan_Floating_Entrance_Icons"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:paddingLeft="8dp"
                    android:layout_gravity="start|center_vertical" />
            </FrameLayout>

        </LinearLayout>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/Trashcan_Floating_Entrance"
            android:padding="8dp">

            <FrameLayout
                android:id="@+id/btnNavigate"
                android:layout_width="24dp"
                android:layout_height="26dp"
                android:layout_gravity="start|center_vertical"
                android:background="@drawable/recycler_logo_icon_4"
                android:backgroundTint="@color/Trashcan_Floating_Entrance_Icons"
                >
            </FrameLayout>
        </FrameLayout>

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>